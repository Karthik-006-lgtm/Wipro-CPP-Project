APP_NAME="AI-Powered Job Seeker Portal API"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# CORS configuration
CORS_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# PostgreSQL Database Configuration
# Driver: psycopg (PostgreSQL 3.x driver for SQLAlchemy)
# Example: postgresql+psycopg://username:password@localhost:5432/jobseeker_portal
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/jobseeker_portal"

# AI & Service Integrations (Phase 7 Gemini Gateway)
# Set GEMINI_API_KEY to activate genuine AI co-pilot responses.
# Leave empty to run in honest unconfigured mode with full deterministic portal features.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-2.5-flash"
GEMINI_TIMEOUT_SECONDS=30.0
GEMINI_MAX_OUTPUT_TOKENS=2048
GEMINI_TEMPERATURE=0.7

# Judge0 Code Execution Sandbox
JUDGE0_API_URL="https://judge0-ce.p.rapidapi.com"
JUDGE0_API_KEY=""

# Background processing & caching (optional)
REDIS_URL="redis://localhost:6379/0"
